{
  "name": "vibehub",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  // Static files (the website) are served free and unlimited; the Worker only runs for /api/*
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "vibehub-db", "database_id": "PASTE_YOUR_DATABASE_ID_HERE" }
  ]
}
